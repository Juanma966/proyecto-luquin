---
import Layout from '../layouts/Layout.astro';
import SponsorHeader from '../components/SponsorHeader.astro';
import SponsorHero from '../components/SponsorHero.astro';
import WhySponsor from '../components/WhySponsor.astro';
import CommercialSpaces from '../components/CommercialSpaces.astro';
import Stands from '../components/Stands.astro';
import SponsorTiers from '../components/SponsorTiers.astro';
import CommercialBenefits from '../components/CommercialBenefits.astro';
import ContactForm from '../components/ContactForm.astro';
import SponsorFaq from '../components/SponsorFaq.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<Layout
	title="ALUQUINADA 2027 · Sponsors"
	description="Sé sponsor de ALUQUINADA 2027: espacios comerciales, stands y categorías de patrocinio en el evento beauty del año."
>
	<SponsorHeader />
	<SponsorHero />
	<WhySponsor />
	<CommercialSpaces />
	<SponsorTiers />
	<Stands />
	<CommercialBenefits />
	<ContactForm />
	<SponsorFaq />
	<Footer />
	<WhatsAppFloat message="Hola quisiera un asesoramiento personal sobre ALUQUINADA 2027, Gracias!" />
</Layout>
