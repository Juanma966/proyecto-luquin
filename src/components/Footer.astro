---
import { Icon } from 'astro-icon/components';
import logo from '../assets/excellenceproducciones_logo.webp';
import logo2 from '../assets/excellenceproducciones_horizontal claro.webp';

const year = new Date().getFullYear();

const navLinks = [
	{ label: 'Evento', href: '/#evento' },
	{ label: 'Entradas', href: '/#entradas' },
	{ label: 'Ser sponsor', href: '/sponsors' },
];

const socials = [
	{ label: 'Instagram', href: 'https://www.instagram.com/excellence.producciones?igsh=MXE1dWtpMnFpdTIycQ==', icon: 'simple-icons:instagram' },
	{ label: 'Correo', href: 'mailto:info@excellenceproducciones.com', icon: 'lucide:mail' },
	{ label: 'WhatsApp', href: 'https://wa.me/5492645739387', icon: 'simple-icons:whatsapp' },
];
---

<!-- Footer -->
<footer class="border-t border-neutral-800 bg-neutral-950">
	<div class="mx-auto max-w-6xl px-4 py-12">
		<div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
			<div>
				<a href="/" class="text-lg font-bold tracking-tight">ALUQUINADA 2027</a>
				<img src={logo.src} alt="Excellence Producciones" class="mt-3 h-40 w-auto" />
				<p class="mt-2 max-w-xs text-sm text-neutral-300">
					Descripción breve placeholder del evento.
				</p>
			</div>

			<nav class="flex flex-col gap-3">
				<span class="text-sm font-semibold">Navegación</span>
				{
					navLinks.map((link) => (
						<a
							href={link.href}
							class="text-sm text-neutral-300 transition hover:text-white"
						>
							{link.label}
						</a>
					))
				}
				<img src={logo2.src} alt="Excellence Producciones" class="mt-3 h-24 w-auto max-w-none self-start -ml-4 translate-y-4" />
			</nav>

			<div class="flex flex-col gap-3">
				<span class="text-sm font-semibold">Síguenos</span>
				<div class="flex gap-4">
					{
						socials.map((social) => (
							<a
								href={social.href}
								aria-label={social.label}
								target={social.href.startsWith('http') ? '_blank' : undefined}
								rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
								class="text-neutral-300 transition hover:text-white"
							>
								<Icon name={social.icon} class="h-5 w-5" />
							</a>
							
						))
						

					}
					
				</div>
			</div>
		</div>

		<div class="mt-10 border-t border-neutral-800 pt-6 text-sm text-neutral-400">
			© {year} Aluquinada - Excellence Producciones. Todos los derechos reservados.
		</div>
	</div>
</footer>
<!-- End Footer -->
