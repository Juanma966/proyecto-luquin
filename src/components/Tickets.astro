---
const tickets = [
	{
		name: 'Entrada General',
		price: 'Por confirmar',
		description: 'Acceso general al evento.',
		features: ['Acceso al evento', 'Beneficio placeholder', 'Beneficio placeholder'],
		featured: false,
	},
	{
		name: 'Entrada VIP',
		price: 'Por confirmar',
		description: 'Acceso preferencial y beneficios adicionales.',
		features: ['Todo lo de General', 'Zona VIP', 'Beneficio placeholder', 'Beneficio placeholder'],
		featured: true,
	},
	{
		name: 'Entrada Premium',
		price: 'Por confirmar',
		description: 'La mejor experiencia del evento.',
		features: ['Todo lo de VIP', 'Beneficio placeholder', 'Beneficio placeholder'],
		featured: false,
	},
];
---

<!-- Entradas -->
<section id="entradas" class="bg-neutral-50 py-16 sm:py-24">
	<div class="mx-auto max-w-6xl px-4">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Entradas</h2>
			<p class="mt-4 text-base text-neutral-600 sm:text-lg">
				Elige tu tipo de entrada. Precios y beneficios son placeholder hasta recibir la
				información oficial.
			</p>
		</div>

		<div class="mt-12 grid gap-6 lg:grid-cols-3">
			{
				tickets.map((ticket) => (
					<div
						class:list={[
							'flex flex-col rounded-2xl border bg-white p-6',
							ticket.featured ? 'border-brand ring-1 ring-brand' : 'border-neutral-200',
						]}
					>
						{ticket.featured && (
							<span class="mb-4 inline-block self-start rounded-full bg-brand px-3 py-1 text-xs font-semibold text-brand-contrast">
								Más popular
							</span>
						)}
						<h3 class="text-lg font-semibold">{ticket.name}</h3>
						<p class="mt-1 text-sm text-neutral-600">{ticket.description}</p>
						<p class="mt-4 text-2xl font-bold">{ticket.price}</p>
						<ul class="mt-6 mb-8 flex flex-col gap-2 text-sm text-neutral-600">
							{ticket.features.map((feature) => (
								<li class="flex items-start gap-2">
									<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-neutral-400" />
									{feature}
								</li>
							))}
						</ul>
						<a
							href="#"
							class:list={[
								'mt-auto rounded-full px-6 py-3 text-center font-semibold transition',
								ticket.featured
									? 'bg-brand text-brand-contrast hover:opacity-90'
									: 'border border-neutral-300 text-neutral-800 hover:bg-neutral-100',
							]}
						>
							Comprar
						</a>
					</div>
				))
			}
		</div>
	</div>
</section>
<!-- End Entradas -->
