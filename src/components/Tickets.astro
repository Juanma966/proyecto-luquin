---
import bgThemed from '../assets/bg-themed.webp';
---

<!-- Entradas -->
<section
	id="entradas"
	class="bg-cover bg-center bg-no-repeat py-16 sm:py-24"
	style={`background-image: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)), url(${bgThemed.src})`}
>
	<div class="mx-auto max-w-6xl px-4">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Entradas</h2>
			<p class="mt-4 text-base text-neutral-300 sm:text-lg">
				Compra tu entrada y guarda la fecha, accediendo a promos exclusivas.
			</p>
		</div>

		<div class="mt-12 grid gap-4 sm:grid-cols-3">
			
			
		</div>

		<div class="mt-12 flex justify-center">
			<a
				href="#"
				class="rounded-full bg-brand px-8 py-3 font-semibold text-brand-contrast transition hover:opacity-90"
			>
				Comprar entradas
			</a>
		</div>
	</div>
</section>
<!-- End Entradas -->
