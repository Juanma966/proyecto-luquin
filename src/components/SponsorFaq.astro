---
const faqs = [
	{ q: 'Pregunta frecuente placeholder 1', a: 'Respuesta placeholder 1 sobre la contratación de espacios.' },
	{ q: 'Pregunta frecuente placeholder 2', a: 'Respuesta placeholder 2 sobre las categorías de patrocinio.' },
	{ q: 'Pregunta frecuente placeholder 3', a: 'Respuesta placeholder 3 sobre los espacios comerciales.' },
	{ q: 'Pregunta frecuente placeholder 4', a: 'Respuesta placeholder 4 sobre el proceso de contratación.' },
];
---

<!-- Preguntas Frecuentes -->
<section class="py-16 sm:py-24">
	<div class="mx-auto max-w-3xl px-4">
		<div class="text-center">
			<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Preguntas Frecuentes</h2>
			<p class="mt-4 text-base text-neutral-300 sm:text-lg">
				Consultas sobre la contratación de espacios y categorías de patrocinio.
			</p>
		</div>

		<div class="mt-10 flex flex-col gap-3">
			{
				faqs.map((faq) => (
					<details class="rounded-2xl border border-neutral-800 bg-neutral-900 p-6">
						<summary class="cursor-pointer list-none font-medium">{faq.q}</summary>
						<p class="mt-3 text-sm text-neutral-300">{faq.a}</p>
					</details>
				))
			}
		</div>
	</div>
</section>
<!-- End Preguntas Frecuentes -->
