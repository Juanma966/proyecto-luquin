---
import { Image } from 'astro:assets';
import 'glightbox/dist/css/glightbox.min.css';
import standPlano from '../assets/stand-plano.webp';
import stand1 from '../assets/stand1.webp';
import standMedida from '../assets/stand-medida.webp';

const slides = [
	{
		title: 'Plano general del salón',
		text: 'Diseñamos un recorrido pensado para maximizar la circulación de asistentes por cada espacio.Seleccioná la zona que mejor se adapte a tu experiencia de marca. Diseñamos espacios óptimos para networking, exhibición de producto y generación de alianzas..',
		image: standPlano,
	},
	{
		title: 'Stand listos para Destacar',
		text: 'Espacios funcionales y de alto impacto diseñados para que recibas a tus clientes y potenciales aliados en un entorno profesional y cómodo.',
		image: stand1,
	},
	{
		title: 'Especificaciones Técnicas y medidas',
		text: 'Aquí encontrarás las áreas útiles de impresión para cenefas y placas divisorias en perfilería de aluminio, garantizando que el diseño de tu marca se adapte a la perfección..',
		image: standMedida,
	},
];
---

<!-- Espacios Comerciales -->
<section class="py-16 sm:py-24">
	<div class="mx-auto max-w-6xl px-4">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Espacios Comerciales</h2>
			<p class="mt-4 text-base text-neutral-300 sm:text-lg">
				Descripción del sector comercial del evento. Deslizá para ver el plano y la distribución.
			</p>
		</div>

		<div class="mt-12 flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4">
			{
				slides.map((slide) => (
					<article class="flex w-full shrink-0 snap-center flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">
						<a
							href={slide.image.src}
							class="glightbox block w-full cursor-zoom-in sm:w-1/2"
							data-gallery="espacios-comerciales"
							aria-label={`Ampliar imagen: ${slide.title}`}
						>
							<Image
								src={slide.image}
								alt={slide.title}
								loading="lazy"
								class="aspect-video w-full rounded-2xl bg-neutral-800 object-contain"
							/>
						</a>
						<div class="sm:w-1/2">
							<h3 class="text-xl font-semibold">{slide.title}</h3>
							<p class="mt-2 text-base text-neutral-300">{slide.text}</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
<!-- End Espacios Comerciales -->

<script>
	import GLightbox from 'glightbox';

	GLightbox({
		selector: '.glightbox',
		loop: true,
		touchNavigation: true,
	});
</script>
