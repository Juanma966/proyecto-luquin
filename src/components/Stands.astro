---
import { Image } from 'astro:assets';
import standEsquina2 from '../assets/stand-esquina2.webp';
import standAluquinada from '../assets/stand-aluquinada.webp';
import standAluquinada2 from '../assets/stand-aluqinada2.webp';

const stands = [
	{
		name: 'Stand Tipo A',
		size: 'Medidas placeholder',
		image: standEsquina2,
		features: ['Características placeholder', 'Equipamiento incluido placeholder', 'Ubicación placeholder'],
	},
	{
		name: 'Stand Tipo B',
		size: 'Medidas placeholder',
		image: standAluquinada,
		features: ['Características placeholder', 'Equipamiento incluido placeholder', 'Ubicación placeholder'],
	},
	{
		name: 'Stand Tipo C',
		size: 'Medidas placeholder',
		image: standAluquinada2,
		features: ['Características placeholder', 'Equipamiento incluido placeholder', 'Ubicación placeholder'],
	},
];
---

<!-- Nuestros Stands -->
<section class="py-16 sm:py-24">
	<div class="mx-auto max-w-6xl px-4">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Nuestros Stands</h2>
			<p class="mt-4 text-base text-neutral-300 sm:text-lg">
				Tipos de stands disponibles. Medidas y equipamiento son placeholder.
			</p>
		</div>

		<div class="mt-12 grid gap-6 md:grid-cols-3">
			{
				stands.map((stand) => (
					<div class="flex flex-col rounded-2xl border border-neutral-800 bg-neutral-900 p-6">
						<Image
							src={stand.image}
							alt={stand.name}
							loading="lazy"
							class="aspect-video w-full rounded-xl bg-neutral-800 object-cover"
						/>
						<h3 class="mt-4 text-lg font-semibold">{stand.name}</h3>
						<p class="mt-1 text-sm text-neutral-300">{stand.size}</p>
						<ul class="mt-4 flex flex-col gap-2 text-sm text-neutral-300">
							{stand.features.map((feature) => (
								<li class="flex items-start gap-2">
									<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-neutral-400" />
									{feature}
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</section>
<!-- End Nuestros Stands -->
