---
const benefits = [
	'Posicionamiento de marca',
	'Genera nuevos contactos comerciales',
	'Incrementa tus ventas',
	'Presenta lanzamientos y novedades',
	'Crea experiencias memorables con potenciales consumidores',
	'Ubicación estratégica de los stands, aumentando tu visibilidad',
	'Fideliza tus clientes',
];
---

<!-- Beneficios Comerciales -->
<section class="py-16 sm:py-24">
	<div class="mx-auto max-w-6xl px-4">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Beneficios Comerciales</h2>
			<p class="mt-4 text-base text-neutral-300 sm:text-lg">
				Oportunidades que ofrece el evento para las marcas. Los íconos son placeholder.
			</p>
		</div>

		<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				benefits.map((benefit) => (
					<div class="flex items-start gap-4 rounded-2xl border border-neutral-800 bg-neutral-900 p-6">
						<div class="h-10 w-10 shrink-0 rounded-full bg-neutral-800" />
						<p class="text-sm font-medium text-neutral-200">{benefit}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
<!-- End Beneficios Comerciales -->
