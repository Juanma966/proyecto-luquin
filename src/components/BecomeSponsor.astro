---
import bgThemed from '../assets/bg-themed.webp';
---

<!-- Ser sponsor -->
<section
	id="sponsor"
	class="bg-cover bg-center bg-no-repeat py-16 sm:py-24"
	style={`background-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.55) 55%, rgba(0, 0, 0, 1) 100%), url(${bgThemed.src})`}
>
	<div class="mx-auto max-w-6xl px-4">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Conviértete en sponsor</h2>
			<p class="mt-4 text-base text-neutral-300 sm:text-lg">
				Formá parte del evento Beauty más impactante y posicioná tu marca entre referentes del mundo beauty.
			</p>
		</div>

		

		<div class="mt-12 flex justify-center">
			<a
				href="/sponsors"
				class="rounded-full bg-brand px-8 py-3 font-semibold text-brand-contrast transition hover:opacity-90"
			>
				Ser sponsor
			</a>
		</div>
	</div>
</section>
<!-- End Ser sponsor -->