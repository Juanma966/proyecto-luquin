---
type Slide = { title: string; text: string; youtubeId: string };

const slides: Slide[] = [
	{ title: 'Aprende junto a Luquin', text: 'Una jornada de capacitación intensiva con Josué Luquin para dominar las técnicas de maquillaje más avanzadas del mercado, actualizar tus servicios y elevar el valor de tu trabajo.', youtubeId: 'iGkbkyCc9bs' },
	{ title: 'Experiencia & Comunidad', text: 'Más que un evento, un punto de encuentro aspiracional. Disfrutá de un ambiente premium donde la comunidad beauty se reúne a crear alianzas, inspirarse y celebrar el arte del maquillaje en una jornada inolvidable.', youtubeId: 'tkF2i8fGucE' },
	{ title: 'Explorá las mejores Marcas & Novedades', text: 'Explorá y testeá insumos de primer nivel antes que nadie. Un espacio interactivo para conocer lanzamientos, probar fórmulas en directo y renovar tu kit de productos con las firmas más destacadas de la industria.', youtubeId: 'CywqiUfdJ6A' },
];

// Autoplay silencioso en bucle, sin controles ni teclado; `playlist` es lo que habilita el loop
const embedUrl = (id: string) =>
	`https://www.youtube-nocookie.com/embed/${id}?autoplay=1&mute=1&loop=1&playlist=${id}&controls=0&rel=0&playsinline=1&disablekb=1&enablejsapi=1`;
---

<!-- ¿De qué trata el evento? -->
<section id="evento" class="py-16 sm:py-24">
	<div class="mx-auto max-w-6xl px-4">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">La Experiencia Beauty del Año</h2>
			<p class="mt-4 text-base text-neutral-300 sm:text-lg">
				Una experiencia exclusiva en el Hilton Mendoza junto a Josué Luquin, que reúne técnica, inspiración, networking y las mejores marcas de la industria beauty.

Deslizá y descubrí la experiencia.
			</p>
		</div>

		<div class="mt-12 flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4" data-autocarousel>
			{
				slides.map((slide) => (
					<article class="flex w-full shrink-0 snap-center flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">
						<div class="sm:w-1/2">
							<h3 class="text-xl font-semibold">{slide.title}</h3>
							<p class="mt-2 text-base text-neutral-300">{slide.text}</p>
						</div>
						<div
							data-yt
							class="relative aspect-video w-full overflow-hidden rounded-2xl bg-neutral-800 sm:w-1/2"
						>
							<iframe
								src={embedUrl(slide.youtubeId)}
								title={slide.title}
								allow="autoplay; encrypted-media; picture-in-picture"
								referrerpolicy="strict-origin-when-cross-origin"
								class="absolute left-1/2 top-1/2 aspect-[9/16] w-full -translate-x-1/2 -translate-y-1/2 border-0"
							/>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
<!-- End ¿De qué trata el evento? -->

<script>
	const carousel = document.querySelector<HTMLElement>('[data-autocarousel]');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Reproduce automáticamente solo el video del slide visible y pausa el resto
	if (carousel) {
		const wrappers = carousel.querySelectorAll<HTMLElement>('[data-yt]');

		const command = (frame: HTMLIFrameElement, func: 'playVideo' | 'pauseVideo') =>
			frame.contentWindow?.postMessage(JSON.stringify({ event: 'command', func, args: [] }), '*');

		if (reduceMotion) {
			wrappers.forEach((wrapper) => {
				const frame = wrapper.querySelector('iframe');
				if (frame) frame.src = frame.src.replace('autoplay=1', 'autoplay=0');
			});
		} else if (wrappers.length) {
			// Observa el contenedor recortado y no el iframe: el iframe desborda y nunca llegaría al umbral
			const io = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						const frame = entry.target.querySelector('iframe');
						if (frame) command(frame, entry.isIntersecting ? 'playVideo' : 'pauseVideo');
					});
				},
				{ threshold: 0.6 },
			);

			wrappers.forEach((wrapper) => io.observe(wrapper));
		}
	}

	if (carousel && !reduceMotion) {
		const slides = Array.from(carousel.children) as HTMLElement[];

		if (slides.length > 1) {
			let index = 0;
			let timer: number | undefined;

			const go = (i: number) => {
				index = (i + slides.length) % slides.length;
				carousel.scrollTo({
					left: slides[index].offsetLeft - carousel.offsetLeft,
					behavior: 'smooth',
				});
			};

			const start = () => {
				stop();
				timer = window.setInterval(() => go(index + 1), 6000);
			};

			const stop = () => window.clearInterval(timer);

			// Resincroniza el índice con el slide visible tras deslizar manualmente
			let scrollTimer: number | undefined;
			const syncIndex = () => {
				const pos = carousel.scrollLeft + carousel.offsetLeft;
				index = slides.reduce(
					(best, slide, i) =>
						Math.abs(slide.offsetLeft - pos) < Math.abs(slides[best].offsetLeft - pos) ? i : best,
					0,
				);
			};

			carousel.addEventListener('scroll', () => {
				window.clearTimeout(scrollTimer);
				scrollTimer = window.setTimeout(syncIndex, 150);
			});

			// Pausa mientras el usuario interactúa
			carousel.addEventListener('mouseenter', stop);
			carousel.addEventListener('mouseleave', start);
			carousel.addEventListener('pointerdown', stop);
			carousel.addEventListener('pointerup', start);

			start();
		}
	}
</script>
