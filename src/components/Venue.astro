---
import { Image } from 'astro:assets';
import hotelAereo from '../assets/hilton-aereo-hq.webp';
import hotelSalon from '../assets/hilton-conference-hq.webp';
import hotelEntrada from '../assets/hilton-gate-hq.webp';

const gallery = [
	{ src: hotelAereo, alt: 'Vista aérea del complejo del Hotel Hilton' },
	{ src: hotelSalon, alt: 'Salón de eventos del Hotel Hilton' },
	{ src: hotelEntrada, alt: 'Entrada principal del Hotel Hilton' },
];
---

<!-- Hotel Hilton -->
<section id="hotel" class="bg-neutral-50 py-16 sm:py-24">
	<div class="mx-auto max-w-6xl px-4">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">¡Nos vemos en el Hotel Hilton!</h2>
			<p class="mt-4 text-base text-neutral-600 sm:text-lg">
				Un día inolvidable, en un lugar inolvidable, viví la experiencia completa.
			</p>
		</div>

		<div class="mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4">
			{
				gallery.map((photo) => (
					<Image
						src={photo.src}
						alt={photo.alt}
						class="aspect-video w-72 shrink-0 snap-center rounded-2xl object-cover sm:w-96"
					/>
				))
			}
		</div>

		<div class="mt-8 flex justify-center">
			<a
				href="https://maps.app.goo.gl/J9yE2LSjSAWVMkd88"
				target="_blank"
				rel="noopener"
				class="rounded-full border border-neutral-300 px-6 py-3 font-semibold text-neutral-800 transition hover:bg-neutral-100"
			>
				¿Cómo llegar?
			</a>
		</div>
	</div>
</section>
<!-- End Hotel Hilton -->
