---
import heroSponsor from '../assets/herosponsor.webp';
---

<!-- Hero Comercial -->
<section
	class="bg-cover bg-center bg-no-repeat py-16 sm:py-24"
	style={`background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url(${heroSponsor.src})`}
>
	<div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 text-center">
		<p class="text-sm font-medium tracking-widest text-brand uppercase">Propuesta comercial</p>
		<h1 class="text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl">
			Sé Protagonista del Evento Beauty del Año
		</h1>
		<p class="max-w-xl text-base text-neutral-300 sm:text-lg">
			Rodeate de referentes y profesionales del make up, posicionando tu marca en áreas estrategicamente ubicadas.
		</p>
		<a
			href="#contacto"
			class="rounded-full bg-brand px-6 py-3 font-semibold text-brand-contrast transition hover:opacity-90"
		>
			Solicitar información
		</a>
	</div>
</section>
<!-- End Hero Comercial -->
