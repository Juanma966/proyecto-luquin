---
const reasons = [
	{ title: 'Alcance', text: 'meses de exposición continua sumados al evento Beauty más importante del año.' },
	{ title: 'Visibilidad de marca', text: 'Posicione su marca ante una audiencia altamente segmentada con proyección y alcance nacional e internacional.' },
	{ title: 'Networking', text: 'Viva el networking en su máxima expresión: un espacio único para crear contactos, intercambiar tendencias e interactuar con grandes referentes del maquillaje global.' },
	{ title: 'Enfoque Profesional', text: 'Acelere la adopción de sus lanzamientos y potencie su volumen de ventas conectando su catálogo con el público indicado.' },
];
---

<!-- ¿Por qué ser Sponsor? -->
<section class="py-16 sm:py-24">
	<div class="mx-auto max-w-6xl px-4">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">¿Por qué ser Sponsor?</h2>
			<p class="mt-4 text-base text-neutral-300 sm:text-lg">
				Ser Sponsor de <strong>ALUQUINADA</strong> es posicionar su empresa en el Evento Beauty de Mayor proyección del país.
			</p>
		</div>

		<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				reasons.map((reason) => (
					<div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-6">
						<div class="mb-4 h-10 w-10 rounded-full bg-neutral-800" />
						<h3 class="text-lg font-semibold">{reason.title}</h3>
						<p class="mt-2 text-sm text-neutral-300">{reason.text}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
<!-- End ¿Por qué ser Sponsor? -->
