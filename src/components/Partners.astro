---
import { Image } from 'astro:assets';
import logoHorizontalAzul from '../assets/LOGO HORIZONTAL AZUL.webp';
import logoPrincipalColor from '../assets/logoprincipal_color.webp';

const logos = [
	{ src: logoHorizontalAzul, alt: 'Logo horizontal azul' },
	{ src: logoPrincipalColor, alt: 'Logo principal' },
];

// Se repite la secuencia para llenar la cinta y se duplica para un bucle continuo.
const base = Array.from({ length: 4 }, () => logos).flat();
const loop = [...base, ...base];
---

<!-- Empresas que nos acompañan -->
<section class="py-16 sm:py-24">
	<div class="mx-auto max-w-6xl px-4">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Empresas que nos acompañan</h2>
			<p class="mt-4 text-base text-neutral-300 sm:text-lg">
				Marcas que eligen ser parte de ALUQUINADA 2027.
			</p>
		</div>
	</div>

	<div class="marquee mt-12 overflow-hidden">
		<div class="marquee__track flex w-max gap-6">
			{
				loop.map((logo, i) => (
					<div
						aria-hidden={i >= logos.length ? 'true' : undefined}
						class="flex h-24 w-40 shrink-0 items-center justify-center rounded-2xl border border-neutral-800 bg-neutral-900 p-4"
					>
						<Image
							src={logo.src}
							alt={i < logos.length ? logo.alt : ''}
							loading="lazy"
							class="max-h-full max-w-full object-contain"
						/>
					</div>
				))
			}
		</div>
	</div>
</section>
<!-- End Empresas que nos acompañan -->

<style>
	.marquee__track {
		animation: marquee 25s linear infinite;
	}

	@keyframes marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee__track {
			animation: none;
		}
	}
</style>
