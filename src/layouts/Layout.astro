---
import '../styles/global.css';
import favicon from '../assets/excellenceproducciones_logo.webp';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { title, description, image = '/og-image.jpg' } = Astro.props;

const site = Astro.site ?? new URL('https://excellenceproducciones.com');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/webp" href={favicon.src} />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />

		<!-- Open Graph (WhatsApp / Facebook) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="ALUQUINADA 2027" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body>
		<slot />
	</body>
</html>
